# Copy to .env and fill in before running `docker compose up`.
# Generate a key with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"

# --- Django ------------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
# Hosts allowed to serve the app (comma separated). Required when DEBUG=False.
ALLOWED_HOSTS=localhost,127.0.0.1
# Needed for POST requests once you serve over HTTPS / a real domain.
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# --- Database ----------------------------------------------------------------
POSTGRES_DB=linkshortner
POSTGRES_USER=linkshortner
POSTGRES_PASSWORD=change-me

# --- Application -------------------------------------------------------------
SITE_NAME=LinkShortner
SHORT_CODE_LENGTH=7
ALLOW_REGISTRATION=True
TIME_ZONE=UTC
LOG_LEVEL=INFO
WEB_PORT=8000

# --- HTTPS (enable once a TLS-terminating proxy sits in front) ---------------
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0

# --- Optional: create an admin account on first boot -------------------------
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=admin@example.com
# DJANGO_SUPERUSER_PASSWORD=change-me
